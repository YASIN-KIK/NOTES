{
  "name": "notes-app",
  "private": true,
  "version": "1.0.0",
  "description": "A simple, cross-platform notes app with folders, tags, markdown, and an optional AI writing assistant. Notes are stored locally.",
  "author": "Yasin Kik",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:vite-dev\" \"npm:electron-dev\"",
    "vite-dev": "vite",
    "electron-dev": "wait-on http://localhost:5173 && electron .",
    "build": "tsc -b && vite build",
    "electron:build": "npm run build && electron-builder --win nsis",
    "electron:build:store": "npm run build && electron-builder --win appx",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.13",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "mqtt": "^5.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "build": {
    "electronLanguages": [
      "en-US"
    ],
    "appId": "com.notesapp.notes",
    "productName": "Notes",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notes"
    },
    "appx": {
      "identityName": "YasinKik.Notes",
      "publisher": "CN=YasinKik",
      "publisherDisplayName": "Yasin Kik",
      "languages": [
        "en-US"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
